# ===================================================
# Wondercart Environment Configuration Template
# Copy this file to `.env` in the server/ directory
# ===================================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200,http://localhost:4300

# Database Configuration (MySQL / PostgreSQL / SQLite)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=wondercart

# JWT Authentication
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Seed Accounts Configuration
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@wondercart.pk
ADMIN_PASSWORD=your_secure_admin_password

EXTRA_ADMIN_NAME=Support Admin
EXTRA_ADMIN_EMAIL=support-admin@wondercart.pk
EXTRA_ADMIN_PASSWORD=your_secure_extra_admin_password
EXTRA_ADMIN_PHONE=03038164288

SHOP_MANAGER_NAME=Demo Shop Manager
SHOP_MANAGER_EMAIL=manager@wondercart.pk
SHOP_MANAGER_PASSWORD=your_secure_manager_password

DEMO_CUSTOMER_NAME=Demo Customer
DEMO_CUSTOMER_EMAIL=customer@wondercart.pk
DEMO_CUSTOMER_PASSWORD=your_secure_customer_password

# Outgoing SMTP Configuration (Transactional Emails)
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Wondercart Store <orders@yourdomain.com>"

# Rate Limiting Configuration (Tiered, Per-IP + Per-Account with Exponential Backoff)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=30
RATE_LIMIT_AUTH_ACCOUNT_MAX=15
RATE_LIMIT_AUTH_FAILURES_BEFORE_BACKOFF=3
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=1000
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_BACKOFF_MAX_MS=60000
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=100
