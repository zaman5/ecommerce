<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/json .json
</IfModule>

# GZIP / Deflate Compression for Ultra Fast Page Load
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML files — always revalidate so deployments update instantly
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript — cache for 1 year (cache busted by hash)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images and fonts
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML - Never cache stale index.html
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Static hashed assets - Cache for 1 year
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Single Page Application (SPA) Routing Rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Aliases for old bundle hashes to prevent 404s on cached tabs
  RewriteRule ^main-2UBPAYW5\.js$ main-OED262FS.js [L]
  RewriteRule ^styles-UZYFWXO7\.css$ styles-RCVLSLXB.css [L]

  # Do not rewrite API or Uploads requests
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/uploads/
  RewriteRule ^ - [L]

  # If requested resource is a real file or directory, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite if request looks like a missing static asset (.js, .css, .ico, etc)
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|json)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Everything else rewrites to index.html for Angular SPA
  RewriteRule ^ index.html [L]
</IfModule>
