# ==============================================================================
# WonderCart Environment Configuration Template
# Copy this file to `.env` (or `server/.env`) and populate with your environment credentials.
# NEVER commit your actual `.env` file to git repository.
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200
SITE_URL=https://wondercart.pk

# Database Configuration (MySQL / MariaDB / SQLite)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_database_password_here
DB_NAME=wondercart

# Authentication & Security
# Generate a strong 64+ char random string for production
JWT_SECRET=replace_with_a_long_random_secure_secret_key_in_production
JWT_EXPIRES_IN=7d

# Initial Administrative Seed (Optional for setup)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@wondercart.pk
ADMIN_PASSWORD=your_secure_admin_password_here

# SMTP / Transactional Email Service
SMTP_HOST=mail.wondercart.pk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@wondercart.pk
SMTP_PASS=your_smtp_app_password_here

# Multi-Tier Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=30
RATE_LIMIT_AUTH_ACCOUNT_MAX=15
RATE_LIMIT_AUTH_FAILURES_BEFORE_BACKOFF=3
RATE_LIMIT_AUTH_BACKOFF_BASE_MS=1000
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_BACKOFF_MAX_MS=60000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_UPLOAD_MAX=100

